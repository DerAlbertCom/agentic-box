#!/bin/sh
# Usage: bundle <entry> <outFile>
# Bundles <entry>, a module of the Bun workspace given relative to this folder (sbox-cli),
# into one file for Bun. Runs the pinned Bun in a container, so the host needs only
# Docker. The Bun version matches bun in the mise tools of the workload. A certificate
# file in NODE_EXTRA_CA_CERTS on the host, such as the chain of a TLS-inspecting proxy,
# is trusted by bun install too.
set -eu

# The current folder as Docker on the host names it: pwd -W gives the Windows path under
# the sh of Git for Windows, which Docker Desktop needs for folders such as /tmp.
host_pwd() { pwd -W 2>/dev/null || pwd; }

bun_image="oven/bun:1.4.4"
workspace="$(cd "$(dirname "$0")" && host_pwd)"
entry="$1"
out_dir="$(mkdir -p "$(dirname "$2")" && cd "$(dirname "$2")" && host_pwd)"
out_name="$(basename "$2")"

set --
if [ -n "${NODE_EXTRA_CA_CERTS:-}" ] && [ -f "$NODE_EXTRA_CA_CERTS" ]; then
  set -- --volume "$NODE_EXTRA_CA_CERTS:/etc/abox-extra-ca-certs.pem:ro" \
    --env NODE_EXTRA_CA_CERTS=/etc/abox-extra-ca-certs.pem
fi

docker run --rm \
  --volume "$workspace:/src:ro" \
  --volume "$out_dir:/out" \
  --volume agentic-box-bun-cache:/root/.bun/install/cache \
  "$@" \
  --env OWNER="$(id -u):$(id -g)" \
  --env ENTRY="$entry" \
  --env OUT_NAME="$out_name" \
  "$bun_image" sh -euc '
    mkdir /work
    cd /src
    workspaces="$(bun -e "console.log(require(\"/src/package.json\").workspaces.join(\" \"))")"
    tar --exclude=node_modules -cf - package.json bun.lock tsconfig.json $workspaces | tar -xf - -C /work
    cd /work
    bun install --frozen-lockfile
    bun build --target=bun "$ENTRY" --outfile "/out/$OUT_NAME"
    chown "$OWNER" "/out/$OUT_NAME"
  '
