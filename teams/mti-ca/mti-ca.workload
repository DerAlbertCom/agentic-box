template: docker.io/docker/sandbox-templates:shell-docker@sha256:b178ca62ec2e79af2a044e3ec321bdb72188690e1c15d573ea5524b397554d3d
publishRepository: mtiae-developer-container-images-local
apt:
  - ca-certificates
  - curl
  - gnupg # verify apt repository keys
  - software-properties-common # add-apt-repository, for the git PPA
  - unzip
  - libsecret-1-0 # keyring for stored credentials
  - build-essential # gcc and make, to build tig
  - file # detect file types
  - git
  - pkg-config # build dependency of tig
  - libncurses-dev # build dependency of tig
  - libreadline-dev # build dependency of tig
  - libpcre2-dev # build dependency of tig
  - openssh-server # SSH into the sandbox
  - gettext-base # envsubst

# abox installs the tools in this order: runtimes come before the tools that need them.
# what not needed frequent update should be first here, because these will be layers
mise:
  # Runtimes
  - node@26.13.1
  - npm:npm@12.2.3
  - bun@1.4.5 # JS runtime and package manager, https://bun.sh
  - pnpm@12.24.0
  - python@3.14.10
  - uv@0.13.10 # Python package manager, https://docs.astral.sh/uv
  - powershell@7.7.0
  - dotnet@10.0.404
  - dotnet@11.0.100

  # Shell improvements
  - starship@1.27.0 # shell prompt, https://starship.rs
  - fzf@0.75.0 # fuzzy finder, https://github.com/junegunn/fzf
  - carapace@1.8.5 # shell completions, https://github.com/carapace-sh/carapace-bin
  - bat@0.26.1 # cat with highlighting, https://github.com/sharkdp/bat
  - edit@2.0.0 # Microsoft Edit, terminal editor, https://github.com/microsoft/edit
  - yazi@26.9.1 # terminal file manager, https://github.com/sxyazi/yazi
  - lazygit@0.66.3 # git TUI, https://github.com/jesseduffield/lazygit
  - fd@10.5.2 # fast find, https://github.com/sharkdp/fd
  - oh-my-posh@31.9.1 # PowerShell prompt, https://ohmyposh.dev
  - delta@0.20.1 # git diff pager, https://github.com/dandavison/delta
  # tig, git TUI, built from source: https://github.com/jonas/tig
  - >-
    --tool-option 'version_prefix=tig-'
    --tool-option 'asset_pattern=tig-*.tar.gz'
    --tool-option 'strip_components=1'
    --tool-option 'bin_path=bin'
    --postinstall 'cd "$MISE_TOOL_INSTALL_PATH" && ./configure --prefix="$MISE_TOOL_INSTALL_PATH" && make -j"$(nproc)" && make install && make clean'
    github:jonas/tig@2.6.1

  # Frontend Toolings
  - npm:nx@24.1.0 # monorepo build tool, https://nx.dev
  - npm:@angular/cli@22.3.0
  - npm:@azure-devops/mcp[allow_builds=true]@2.11.1 # Azure DevOps MCP server, https://github.com/microsoft/azure-devops-mcp

  # Dev Tools
  # mongodump, mongorestore and more: https://www.mongodb.com/docs/database-tools
  - >-
    --tool-option 'strip_components=1' --tool-option 'bin_path=bin'
    --tool-option 'platforms={ linux-x64 = { url = "https://fastdl.mongodb.org/tools/db/mongodb-database-tools-ubuntu2404-x86_64-{{ version }}.tgz", checksum = "sha256:20f43dcaa37f5a4841ac5a91da685a488a5ebbd81113c018e25a6b544cc350ea" }, linux-arm64 = { url = "https://fastdl.mongodb.org/tools/db/mongodb-database-tools-ubuntu2404-arm64-{{ version }}.tgz", checksum = "sha256:7644e12e351bceea542921e60769e3ed658fc770dc09eed07bc5cc2a1ca2ca41" } }'
    http:mongodb-database-tools@100.20.1
  # MongoDB shell, OpenSSL 3 build: https://www.mongodb.com/docs/mongodb-shell
  - >-
    --tool-option 'strip_components=1' --tool-option 'bin_path=bin'
    --tool-option 'platforms={ linux-x64 = { asset_pattern = "mongosh-{{ version }}-linux-x64-openssl3.tgz" }, linux-arm64 = { asset_pattern = "mongosh-{{ version }}-linux-arm64-openssl3.tgz" } }'
    mongosh@2.14.3
  - gh@2.106.0
  # gh stack, stacked pull requests, registered as a gh extension: https://github.com/github/gh-stack
  - >-
    --tool-option 'bin=gh-stack'
    --postinstall 'mkdir -p "$HOME/.local/share/gh/extensions/gh-stack" && ln -sf "$MISE_TOOL_INSTALL_PATH/gh-stack" "$HOME/.local/share/gh/extensions/gh-stack/gh-stack"'
    github:github/gh-stack@0.3.0
  - k9s@0.51.0 # Kubernetes TUI, https://k9scli.io
  - helm@4.3.2
  - terraform@1.17.2
  - github:warrensbox/terraform-switcher@1.20.0 # tfswitch, Terraform version switcher, https://github.com/warrensbox/terraform-switcher
  - azure-cli@2.93.0
  - aws-cli@2.42.4
  - aqua:ByteNess/aws-vault@7.19.1 # AWS credential store, https://github.com/ByteNess/aws-vault

  # Agentic Workflows
  - github:agavra/tuicr@0.29.0 # TUI code review, https://github.com/agavra/tuicr
  - npm:hunkdiff[allow_builds=true]@0.25.0 # diff viewer, https://www.npmjs.com/package/hunkdiff
  # herdr core, with an hc alias: https://herdr.dev
  - >-
    --tool-option 'platforms={ linux-x64 = { url = "https://releases.herdr.dev/core/{{ version }}/herdr-core-linux-x86_64.tar.gz", checksum = "sha256:3054ec3992ce80c5715d721caa9dcefa6056721d15dc113f4750afce763ba5df" }, linux-arm64 = { url = "https://releases.herdr.dev/core/{{ version }}/herdr-core-linux-aarch64.tar.gz", checksum = "sha256:98757985245d45f8d73dd85e68b139b7f167c28488bb89edd9834c3f5a5cf4cf" } }'
    --postinstall 'ln -sf herdr-core "$MISE_TOOL_INSTALL_PATH/hc"'
    http:herdr-core@0.1.22
  - npm:codeburn@0.9.28 # AI agent usage and cost, https://www.npmjs.com/package/codeburn
  - npm:@anthropic-ai/claude-code[allow_builds=true]@2.1.332
  - npm:@github/copilot[allow_builds=true]@1.0.116
  - npm:@earendil-works/pi-coding-agent[allow_builds=true]@1.6.1 # pi coding agent, https://www.npmjs.com/package/@earendil-works/pi-coding-agent
  - npm:@opencode/cli[allow_builds=true]@2.4.2 # OpenCode coding agent, https://opencode.ai
  - npm:@fission-ai/openspec@1.17.0 # spec-driven development, https://github.com/Fission-AI/OpenSpec

scripts:
  - configure-shells.sh
