workload: mti-ca
kits:
  - sandbox-agents
  - git-user
  - github-enterprise-auth
  - azure-devops
  - sbox
  - themes
state:
  - ~/.local/share/opencode
  - ~/.local/state/opencode
  - ~/.pi/agent/sessions
  - ~/.copilot
  - ~/.claude/projects
  - ~/.config/codeburn
  - ~/.local/state/bash
  - ~/.local/share/powershell/PSReadLine
  - ~/.local/state/sbox
secrets:
  - service: abox-github-enterprise
    prompt: The fine-grained personal access token for GitHub Enterprise
  - service: abox-azure-devops
    inputs:
      - name: username
        prompt: Azure DevOps Basic username (enter pat)
      - name: pat
        prompt: Azure DevOps PAT
    encoding: base64
