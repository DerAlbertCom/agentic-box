workload: mti-ca
parameters:
  ghe-host: rwe.ghe.com
kits:
  - sandbox-agents
  - git-user
  - name: github-enterprise-auth
    args:
      GHE_HOST: ${{ parameters.ghe-host }}
  - azure-devops
  - sbox
  - themes
state:
  - ~/.local/share/opencode
  - ~/.local/state/opencode
  - ~/.pi/agent/sessions
  - ~/.copilot
  - ~/.claude/projects
  - ~/.config/codeburn
  - ~/.local/state/bash
  - ~/.local/share/powershell/PSReadLine
  - ~/.local/state/sbox
secrets:
  - service: github-enterprise
    host:
      - ${{ parameters.ghe-host }}
      - api.${{ parameters.ghe-host }}
      - uploads.${{ parameters.ghe-host }}
      - copilot-api.${{ parameters.ghe-host }}
    env: GHE_TOKEN
    placeholder: github_pat_{rand}
    prompt: The fine-grained personal access token for GitHub Enterprise
  - service: azure-devops
    inputs:
      - name: username
        prompt: Azure DevOps Basic username (enter pat)
      - name: pat
        prompt: Azure DevOps PAT
    encoding: base64
