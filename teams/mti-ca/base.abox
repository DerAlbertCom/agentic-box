workload: mti-ca
kits:
  - sandbox-agents
  - git-user
  - rwe-ghec
  - azure-devops
  - sbox
  - themes
state:
  - ~/.local/share/opencode
  - ~/.local/state/opencode
  - ~/.pi/agent/sessions
  - ~/.copilot
  - ~/.claude/projects
  - ~/.config/codeburn
  - ~/.local/state/bash
  - ~/.local/share/powershell/PSReadLine
  - ~/.local/state/sbox
secrets:
  - service: rwe-ghec
    host: [copilot-api.rwe.ghe.com, api.rwe.ghe.com, rwe.ghe.com, uploads.rwe.ghe.com]
    env: RWE_GHE_TOKEN
    command: gh auth token -h rwe.ghe.com
    placeholder: gho_{rand}
  - service: azure-devops
    inputs:
      - name: username
        prompt: Azure DevOps Basic username (enter pat)
      - name: pat
        prompt: Azure DevOps PAT
    encoding: base64
