# The secrets squad: the sample team with dummy secrets, to try abox secrets.
# Every value is a dummy: it is sent only to hosts under example.invalid, which never resolve.
base: cape

kits:
  - sample-secrets

secrets:
  - service: abox-sample-token
    prompt: A dummy token (any text)
  - service: abox-sample-basic
    inputs:
      - name: username
        prompt: A dummy username (any text)
      - name: password
        prompt: A dummy password (any text)
    separator: ":"
    encoding: base64
  - service: abox-sample-optional
    prompt: An optional dummy key (empty skips it)
  # A custom secret: no kit asks for it with credential@1; the sandbox sees a placeholder
  # in SAMPLE_CUSTOM_TOKEN that the proxy replaces on requests to the host.
  - service: abox-sample-custom
    host: custom.sample.example.invalid
    env: SAMPLE_CUSTOM_TOKEN
    prompt: A dummy custom token (any text)
  # A custom secret from a host command, sent to several hosts: nobody is asked for a value.
  # From the sources (abox create --local) sbx runs the command; from a sandbox, abox secrets
  # set prints the sbx command with '<host command>' for you to replace with this one.
  - service: abox-sample-command
    host: [api.command.sample.example.invalid, uploads.command.sample.example.invalid]
    env: SAMPLE_COMMAND_TOKEN
    command: echo dummy
    placeholder: dummy_{rand}
