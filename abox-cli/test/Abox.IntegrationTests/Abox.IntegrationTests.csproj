<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.14" />
    <PackageReference Include="TngTech.ArchUnitNET.xUnitV3" Version="0.13.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Abox/Abox.csproj" />
    <ProjectReference Include="../../src/Abox.Core/Abox.Core.csproj" />
    <ProjectReference Include="../../src/Abox.Infrastructure/Abox.Infrastructure.csproj" />
    <ProjectReference Include="../Abox.TestUtilities/Abox.TestUtilities.csproj" />
  </ItemGroup>

  <!-- Infrastructure test helpers, shared with Abox.Infrastructure.Tests. -->
  <ItemGroup>
    <Compile
      Include="../Abox.Infrastructure.Tests/Support/DirectoryLinks.cs"
      Link="Support/DirectoryLinks.cs"
    />
    <Compile
      Include="../Abox.Infrastructure.Tests/Support/DisposableCertificateRuntime.cs"
      Link="Support/DisposableCertificateRuntime.cs"
    />
    <Compile
      Include="../Abox.Infrastructure.Tests/Support/GatedUserSecretsPolicyRunner.cs"
      Link="Support/GatedUserSecretsPolicyRunner.cs"
    />
    <Compile
      Include="../Abox.Infrastructure.Tests/Support/UserSecretsPolicyFixture.cs"
      Link="Support/UserSecretsPolicyFixture.cs"
    />
  </ItemGroup>

  <ItemGroup>
    <Content
      Include="../../../kits/opencode-config/opencode-config.yaml;../../../kits/pi-config/pi-config.yaml"
      Link="Fixtures/Kits/%(Filename)/%(Filename)%(Extension)"
      CopyToOutputDirectory="PreserveNewest"
    />
    <Content
      Include="../../../docs/verification/user-secrets/metadata/*.policy.kit.json"
      Link="Fixtures/Verification/%(Filename)%(Extension)"
      CopyToOutputDirectory="PreserveNewest"
    />
  </ItemGroup>
</Project>
