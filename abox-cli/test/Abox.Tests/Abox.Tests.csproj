<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Abox.Tests</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" Version="9.6.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="NSubstitute" Version="6.2.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageReference Include="xunit.v3.core" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Abox/Abox.csproj" />
    <ProjectReference Include="../Abox.TestUtilities/Abox.TestUtilities.csproj" />
  </ItemGroup>

  <!-- The CLI test application lives in Abox.IntegrationTests; the host tests compile it in. -->
  <ItemGroup>
    <Compile
      Include="../Abox.IntegrationTests/Support/CliTestApplication.cs"
      Link="Support/CliTestApplication.cs"
    />
    <Compile
      Include="../Abox.IntegrationTests/Support/LocalWorkloadFactory.cs"
      Link="Support/LocalWorkloadFactory.cs"
    />
    <Compile
      Include="../Abox.IntegrationTests/Support/SandboxFactory.cs"
      Link="Support/SandboxFactory.cs"
    />
    <Compile
      Include="../Abox.IntegrationTests/Support/TestServiceGraphs.cs"
      Link="Support/TestServiceGraphs.cs"
    />
  </ItemGroup>
</Project>
