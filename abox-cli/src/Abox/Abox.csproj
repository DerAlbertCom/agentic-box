<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Abox</RootNamespace>
    <AssemblyName>abox</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>abox</ToolCommandName>
    <PackageId>RwestAgenticBox.Cli</PackageId>
    <Description>AI agent sandboxes for your folders, built on Docker Sandboxes.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <!-- Framework-dependent, RID-specific tool packages compiled ReadyToRun, plus a
       portable "any" package for every other platform. Packs one pointer package and
       one package per RID; installing needs the .NET 10 SDK or newer. -->
  <PropertyGroup>
    <ToolPackageRuntimeIdentifiers>
      win-x64;win-x86;win-arm64;
      linux-x64;linux-arm64;linux-arm;
      linux-musl-x64;linux-musl-arm64;linux-musl-arm;
      osx-x64;osx-arm64;
      any
    </ToolPackageRuntimeIdentifiers>
    <RuntimeIdentifiers>$(ToolPackageRuntimeIdentifiers)</RuntimeIdentifiers>
    <PublishReadyToRun>true</PublishReadyToRun>
    <SelfContained>false</SelfContained>
    <!-- Run on .NET 10, or on the lowest newer major runtime when 10 is missing. -->
    <RollForward>Major</RollForward>
    <!-- abox runs with invariant globalization; ship no translated library resources. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Abox.IntegrationTests" />
    <InternalsVisibleTo Include="Abox.Tests" />
    <None Include="../../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Abox.Core/Abox.Core.csproj" />
    <ProjectReference Include="../Abox.Infrastructure/Abox.Infrastructure.csproj" />
  </ItemGroup>
</Project>
